import sys
import os
import json
import logging
import tempfile
import subprocess

from os.path import dirname, realpath
sys.path.append(dirname(dirname(realpath(__file__))))

from misc.python_sealog.settings import API_SERVER_FILE_PATH
from misc.python_sealog.cruises import get_cruises, get_cruise_by_id, get_cruise_by_lowering
from misc.python_sealog.lowerings import get_lowerings, get_lowering_by_id, get_lowerings_by_cruise
from misc.python_sealog.misc import get_framegrab_list_by_lowering
from misc.python_sealog.events import get_events_by_lowering
from misc.python_sealog.event_aux_data import get_event_aux_data_by_lowering
from misc.python_sealog.event_exports import get_event_exports_by_lowering
from misc.python_sealog.event_templates import get_event_templates
try:
    from misc.lowering_nav_exporter import ExportLoweringNav, ALT_DESIRED_RAW_COLS
    NAV_CSV_REQS = True
except (ModuleNotFoundError, ImportError):
    NAV_CSV_REQS = False

# Location of exported files.
EXPORT_ROOT_DIR = '/data/sealog-exports'

# Name of the vehicle. This is used in filenames and shouldn't include spaces or special characters.
VEHICLE_NAME = 'Deep_Discoverer'

# Location of sealog-managed files
CRUISES_FILE_PATH = os.path.join(API_SERVER_FILE_PATH, 'cruises')
IMAGES_FILE_PATH = os.path.join(API_SERVER_FILE_PATH, 'images')
LOWERINGS_FILE_PATH = os.path.join(API_SERVER_FILE_PATH, 'lowerings')

# Sub-directory names for storing exported images and uploaded files.
IMAGES_DIRNAME = 'Images'
FILES_DIRNAME = 'Files'

# Enable/Disable copying image files to export directory
EXPORT_IMAGES = True
IMAGE_DATASOURCES = ['eventFileAttachments', 'framegrabber']

EXPORT_NAV_CSV = False

EXPORT_TEMPLATES = False


def _get_nav_csv(lowering):
    """
    Return the navigation data for the given lowering as a CSV string.
    Falls back to the alternative nav data source if the primary fails.
    Returns None if nav data is unavailable.
    """
    if not NAV_CSV_REQS:
        raise RuntimeError('Python module lowering_nav_exporter not found. It '
                           'is likely you just need to copy/rename the '
                           'lowering_nav_exporter file so that it ends in .py')

    try:
        nav_export = ExportLoweringNav(lowering['id'])
    except Exception:  # pylint:disable=W0718
        logging.warning(
            "Primary nav source failed for lowering %s, trying alternative.",
            lowering['lowering_id']
        )
        try:
            nav_export = ExportLoweringNav(lowering['id'], raw_columns=ALT_DESIRED_RAW_COLS)
        except Exception as exc:  # pylint:disable=W0718
            logging.error("Could not export nav for lowering %s: %s", lowering['lowering_id'], exc)
            return None

    if nav_export.data is None or nav_export.data.empty:
        logging.warning("No nav data found for lowering %s", lowering['lowering_id'])
        return None

    return str(nav_export)


# ---------------------------------------------------------------------------
# Export task definitions
#
# Each entry is a dict with:
#   'description' - label used in log output
#   'path'        - callable(cruise, record, dirs) returning the full output path
#   'data_fn'     - callable(record) returning the file content as a string
#
# 'dirs' passed to 'path' contains:
#   For lowering tasks: 'cruise', 'lowering', 'images', 'files'
#   For cruise tasks:   'cruise', 'files'
#
# To add a new export, append an entry to the appropriate list.
# ---------------------------------------------------------------------------

LOWERING_EXPORT_TASKS = [
    {
        'description': 'Lowering Record',
        'path': lambda c, lo, dirs: os.path.join(
            dirs['lowering'], _lowering_file_prefix(c, lo) + '_loweringRecord.json'
        ),
        'data_fn': json.dumps,
    },
    {
        'description': 'Events (json)',
        'path': lambda c, lo, dirs: os.path.join(
            dirs['lowering'], _lowering_file_prefix(c, lo) + '_eventOnlyExport.json'
        ),
        'data_fn': lambda lo: json.dumps(get_events_by_lowering(lo['id'])),
    },
    {
        'description': 'Events (csv)',
        'path': lambda c, lo, dirs: os.path.join(
            dirs['lowering'], _lowering_file_prefix(c, lo) + '_eventOnlyExport.csv'
        ),
        'data_fn': lambda lo: get_events_by_lowering(lo['id'], 'csv'),
    },
    {
        'description': 'Aux Data',
        'path': lambda c, lo, dirs: os.path.join(
            dirs['lowering'], _lowering_file_prefix(c, lo) + '_auxDataExport.json'
        ),
        'data_fn': lambda lo: json.dumps(get_event_aux_data_by_lowering(lo['id'])),
    },
    {
        'description': 'Events with Aux Data (json)',
        'path': lambda c, lo, dirs: os.path.join(
            dirs['lowering'], _lowering_file_prefix(c, lo) + '_sealogExport.json'
        ),
        'data_fn': lambda lo: json.dumps(get_event_exports_by_lowering(lo['id'])),
    },
    {
        'description': 'Events with Aux Data (csv)',
        'path': lambda c, lo, dirs: os.path.join(
            dirs['lowering'], _lowering_file_prefix(c, lo) + '_sealogExport.csv'
        ),
        'data_fn': lambda lo: get_event_exports_by_lowering(lo['id'], 'csv'),
    },
    {
        'description': 'Event Templates',
        'path': lambda c, lo, dirs: os.path.join(
            dirs['lowering'], _lowering_file_prefix(c, lo) + '_eventTemplates.json'
        ),
        'data_fn': lambda lo: json.dumps(get_event_templates()),
    },
    {
        'description': 'Nav (csv)',
        'path': lambda c, lo, dirs: os.path.join(
            dirs['lowering'], _lowering_file_prefix(c, lo) + '_nav.csv'
        ) if EXPORT_NAV_CSV else None,
        'data_fn': _get_nav_csv,
    },
]

CRUISE_EXPORT_TASKS = [
    {
        'description': 'Cruise Record',
        'path': lambda c, _, dirs: os.path.join(
            dirs['cruise'], _cruise_file_prefix(c) + '_cruiseRecord.json'
        ),
        'data_fn': json.dumps,
    },
]


def _cruise_file_prefix(cruise):
    """
    Build the filename prefix for all cruise-related data files.
    """
    return f"{cruise['cruise_id']}_{VEHICLE_NAME}"


def _lowering_file_prefix(cruise, lowering):
    """
    Build the filename prefix for all lowering-related data files.
    """
    return f"{_cruise_file_prefix(cruise)}_{lowering['lowering_id']}"


def _build_lowering_name(cruise, lowering):  # pylint:disable=W0613
    """
    Translate the lowering id from how it is recorded in Sealog to how it
    should appear in the export. Some operators prepend the cruise id.
    """

    # Prepend the lowering id with the cruise id
    # ------------------------------------------
    # return cruise['cruise_id'] + '_' + lowering['lowering_id']

    # Just pass through the lowering id
    # ------------------------------------------
    return lowering['lowering_id']


def _write_file(filepath, content, description):
    """
    Write content to filepath, logging the operation and any errors.
    Skips the write if content is None.
    """
    if content is None:
        logging.warning("Skipping %s: no data returned", description)
        return
    logging.info("Export %s: %s", description, os.path.basename(filepath))
    try:
        with open(filepath, 'w', encoding='utf-8') as file:
            file.write(content)
    except OSError as exc:
        logging.error('Could not create data file: %s', filepath)
        logging.debug(str(exc))


def _make_dir(path):
    """
    Create a directory (and any missing parents), exiting on failure.
    """
    try:
        os.makedirs(path, exist_ok=True)
    except OSError as exc:
        logging.error("Could not create directory: %s", path)
        logging.debug(str(exc))
        sys.exit(1)


def verify_source_directories(cruise, lowerings=None):
    """
    Verify the source directories exist.
    """
    lowerings = lowerings or []

    logging.info("Verifying source directories")

    checks = [
        (CRUISES_FILE_PATH,                              "cannot find cruises file path"),
        (os.path.join(CRUISES_FILE_PATH, cruise['id']),
         f"cannot find source directory for cruise: {cruise['cruise_id']}"),
        (IMAGES_FILE_PATH,                               "cannot find images file path"),
        (LOWERINGS_FILE_PATH,                            "cannot find lowerings file path"),
    ] + [
        (os.path.join(LOWERINGS_FILE_PATH, lo['id']),
         f"cannot find source directory for lowering: {lo['lowering_id']}")
        for lo in lowerings
    ]

    for path, message in checks:
        if not os.path.isdir(path):
            return False, message

    return True, 'success'


def _build_export_directories(dirs):
    """
    Create all export directories in the given dirs dict.
    """
    for path in dirs.values():
        _make_dir(path)


def _export_images(lowering, lowering_dir):
    """
    Rsync framegrab images for the given lowering into the export directory,
    removing any images that are no longer part of the export.
    """
    logging.info("Exporting Images")
    framegrab_list = get_framegrab_list_by_lowering(lowering['id'], IMAGE_DATASOURCES)

    images_dir = os.path.join(lowering_dir, IMAGES_DIRNAME)
    existing = set(os.listdir(images_dir))
    to_delete = existing - {os.path.basename(f) for f in framegrab_list}
    for filename in to_delete:
        try:
            logging.info('Deleting: %s', filename)
            os.remove(os.path.join(images_dir, filename))
        except OSError as exc:
            logging.debug(str(exc))

    with tempfile.NamedTemporaryFile(mode='w+b', delete=False) as file:
        for framegrab in framegrab_list:
            file.write(str.encode(os.path.basename(framegrab) + '\n'))

        subprocess.call([
            'rsync', '-avi', '--progress',
            '--files-from=' + file.name,
            os.path.join(IMAGES_FILE_PATH, ''),
            images_dir
        ])


def _export_lowering_files(lowering, lowering_dir):
    """
    Rsync the lowering's uploaded files into the export directory.
    """
    subprocess.call([
        'rsync', '-avi', '--progress', '--delete',
        os.path.join(LOWERINGS_FILE_PATH, lowering['id'], ''),
        os.path.join(lowering_dir, FILES_DIRNAME)
    ])


def _export_cruise_files(cruise, cruise_dir):
    """
    Rsync the cruise's uploaded files into the export directory.
    """
    subprocess.call([
        'rsync', '-avi', '--progress', '--delete',
        os.path.join(CRUISES_FILE_PATH, cruise['id'], ''),
        os.path.join(cruise_dir, FILES_DIRNAME)
    ])


def export_lowering(cruise, lowering):
    """
    Export all data for the given lowering.
    """
    logging.info("Exporting data for lowering %s", lowering['lowering_id'])

    lowering_dir = os.path.join(
        EXPORT_ROOT_DIR, cruise['cruise_id'], _build_lowering_name(cruise, lowering)
    )
    dirs = {
        'cruise':   os.path.join(EXPORT_ROOT_DIR, cruise['cruise_id']),
        'lowering': lowering_dir,
        'files':    os.path.join(lowering_dir, FILES_DIRNAME),
    }
    if EXPORT_IMAGES:
        dirs['images'] = os.path.join(lowering_dir, IMAGES_DIRNAME)

    _build_export_directories(dirs)

    for task in LOWERING_EXPORT_TASKS:
        filepath = task['path'](cruise, lowering, dirs)
        if filepath is not None:
            _write_file(filepath, task['data_fn'](lowering), task['description'])

    if EXPORT_IMAGES:
        _export_images(lowering, lowering_dir)
    _export_lowering_files(lowering, lowering_dir)


def export_cruise(cruise):
    """
    Export all data for the given cruise.
    """
    logging.info("Exporting data for cruise %s", cruise['cruise_id'])

    cruise_dir = os.path.join(EXPORT_ROOT_DIR, cruise['cruise_id'])
    dirs = {
        'cruise': cruise_dir,
        'files':  os.path.join(cruise_dir, FILES_DIRNAME),
    }

    _build_export_directories(dirs)

    for task in CRUISE_EXPORT_TASKS:
        filepath = task['path'](cruise, None, dirs)
        if filepath is not None:
            _write_file(filepath, task['data_fn'](cruise), task['description'])

    _export_cruise_files(cruise, cruise_dir)


if __name__ == '__main__':

    import argparse

    parser = argparse.ArgumentParser(description='Sealog ' + VEHICLE_NAME + ' Data export')
    parser.add_argument(
        '-v', '--verbosity', dest='verbosity', default=0,
        action='count', help='Increase output verbosity'
    )
    group1 = parser.add_mutually_exclusive_group()
    group1.add_argument(
        '-c', '--current_cruise', action='store_true', default=False,
        help='export the data for the most recent cruise'
    )
    group1.add_argument(
        '-C', '--cruise_id',
        help='export all cruise and lowering data for the specified cruise (i.e. FK200126)'
    )
    group1.add_argument(
        '-L', '--lowering_id',
        help='export data for the specified lowering (i.e. S0314)'
    )

    parsed_args = parser.parse_args()

    LOGGING_FORMAT = '%(asctime)-15s %(levelname)s - %(message)s'
    logging.basicConfig(format=LOGGING_FORMAT)

    LOG_LEVELS = {0: logging.WARNING, 1: logging.INFO, 2: logging.DEBUG}
    parsed_args.verbosity = min(parsed_args.verbosity, max(LOG_LEVELS))
    logging.getLogger().setLevel(LOG_LEVELS[parsed_args.verbosity])

    selected_cruise = None  # pylint:disable=C0103
    selected_lowerings = []

    if parsed_args.current_cruise:
        selected_cruise = next(iter(get_cruises()), None)
        if selected_cruise is None:
            logging.error("There are no cruises available for export")
            sys.exit(0)
        selected_lowerings = get_lowerings_by_cruise(selected_cruise['id'])

    elif parsed_args.cruise_id:
        selected_cruise = get_cruise_by_id(parsed_args.cruise_id)
        if selected_cruise is None:
            logging.error("Cruise %s not found", parsed_args.cruise_id)
            sys.exit(0)
        selected_lowerings = get_lowerings_by_cruise(selected_cruise['id'])

    elif parsed_args.lowering_id:
        selected_lowerings = [get_lowering_by_id(parsed_args.lowering_id)]
        if len(selected_lowerings) == 0:
            logging.error("Lowering %s not found", parsed_args.lowering_id)
            sys.exit(0)
        selected_cruise = get_cruise_by_lowering(selected_lowerings[0]['id'])

    else:
        selected_lowerings = [next(iter(get_lowerings()), None)]
        if selected_lowerings[0] is None:
            logging.error("There are no lowerings available for export")
            sys.exit(0)
        selected_cruise = get_cruise_by_lowering(selected_lowerings[0]['id'])

    if selected_cruise is None:
        logging.error("There is no cruise for the specified lowering")
        sys.exit(0)

    if len(selected_lowerings) == 0:
        logging.error("There are no lowerings for the specified cruise")
        sys.exit(0)

    logging.info("Exporting the following data:")
    logging.info("\tCruise: %s", selected_cruise['cruise_id'])
    logging.info(
        "\tLowering(s): %s",
        ', '.join([lowering['lowering_id'] for lowering in selected_lowerings])
    )

    success, msg = verify_source_directories(selected_cruise, selected_lowerings)
    if not success:
        logging.error(msg)
        sys.exit(0)

    if not os.path.isdir(EXPORT_ROOT_DIR):
        logging.error("Cannot find export directory: %s", EXPORT_ROOT_DIR)
        sys.exit(1)

    export_cruise(selected_cruise)

    for selected_lowering in selected_lowerings:
        export_lowering(selected_cruise, selected_lowering)

    logging.info("Done")
