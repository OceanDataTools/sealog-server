# Docker Compose automatically reads a `.env` file located next to this
# file (see .env.dist for the full list of supported variables) and uses
# it to fill in the ${VAR} references below. If no .env file exists, or a
# variable is missing from it, the fallback after ':-' is used instead.
# SEALOG_SERVER_SECRET has no fallback, so it must be set via .env or the
# shell environment.
services:
  sealog-server:
    build:
      context: .
      dockerfile: Dockerfile
    depends_on:
      - mongo
    environment:
      - SEALOG_SERVER_PORT=${SEALOG_SERVER_PORT:-8000}
      - SEALOG_SERVER_FILEPATH_ROOT=${SEALOG_SERVER_FILEPATH_ROOT:-/data/sealog-files}
      - SEALOG_SERVER_TLS_PRIVKEY=${SEALOG_SERVER_TLS_PRIVKEY:-}
      - SEALOG_SERVER_TLS_FULLCHAIN=${SEALOG_SERVER_TLS_FULLCHAIN:-}
      - SEALOG_SERVER_SENDER_ADDRESS=${SEALOG_SERVER_SENDER_ADDRESS:-}
      - SEALOG_SERVER_NOTIFICATION_EMAIL_ADDRESSES=${SEALOG_SERVER_NOTIFICATION_EMAIL_ADDRESSES:-}
      - SEALOG_SERVER_DISABLE_REGISTERING_USERS=${SEALOG_SERVER_DISABLE_REGISTERING_USERS:-false}
      - SEALOG_SERVER_USE_ACCESS_CONTROL=${SEALOG_SERVER_USE_ACCESS_CONTROL:-false}
      - SEALOG_SERVER_RECAPTCHA_SECRET=${SEALOG_SERVER_RECAPTCHA_SECRET:-}

      # Gmail OAuth2 email integration is enabled when all three are set
      - GMAIL_CLIENT_ID=${GMAIL_CLIENT_ID:-}
      - GMAIL_CLIENT_SECRET=${GMAIL_CLIENT_SECRET:-}
      - GMAIL_REFRESH_TOKEN=${GMAIL_REFRESH_TOKEN:-}

      # Create SEALOG_SERVER_SECRET with:
      # node -e "console.log(require('crypto').randomBytes(256).toString('base64'));"
      - SEALOG_SERVER_SECRET=${SEALOG_SERVER_SECRET:?SEALOG_SERVER_SECRET must be set via .env or the shell environment}

      # NODE_ENV Options are:
      # - production: what to use for realz
      # - development: preloads some events, event templates cruises and lowerings
      # - demo-vessel: preloads some event templates, cruises, and events... good for evaluating Sealog for vessels
      # - demo-vehicle: preloads some event templates, cruises, lowerings and events... good for evaluating Sealog for vehicles
      - NODE_ENV=${NODE_ENV:-production}
      - MONGO_URL=${MONGO_URL:-mongodb://mongo:27017/sealogDB}
    image: sealog-server
    ports:
      - "${SEALOG_SERVER_PORT:-8000}:${SEALOG_SERVER_PORT:-8000}"
    restart: unless-stopped
    volumes:
      # Make sure this directory exists on the host
      - /opt/sealog-server/sealog-files:/data/sealog-files

  mongo:
    image: mongo
    # Uncomment these lines if you need direct access to the database
    # ports:
    #   - "27017:27017"
    volumes:
      - db_data:/data/db

volumes:
  db_data:
