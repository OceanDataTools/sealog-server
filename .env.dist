# =========================================================================
# Sealog-server environment variable template
#
# Copy this file to `.env` and fill in the values for your deployment.
# These variables are read directly by the config/*.js files (see the
# corresponding config/*.js.dist templates for full context/defaults).
#
# NOTE: sealog-server does not currently load a `.env` file automatically.
# Export these variables yourself (e.g. `export $(grep -v '^#' .env | xargs)`
# before starting the server), supply them via your process manager
# (systemd EnvironmentFile=, pm2, etc.), or via Docker Compose's
# `env_file: .env` directive.
# =========================================================================


# -------------------------------------------------------------------------
# config/manifest.js - server + database connection
# -------------------------------------------------------------------------

# HTTP port the server listens on
SEALOG_SERVER_PORT=8000

# Node environment: development | debug | production | demo-vehicle | demo-vessel
NODE_ENV=production

# Full MongoDB connection string. If unset, defaults to
# mongodb://localhost:27017/<SEALOG_DB_NAME or SEALOG_DB_DEVEL_NAME depending on NODE_ENV>
MONGO_URL=

# Paths to TLS private key / fullchain cert to enable HTTPS. If either is
# unset or unreadable, the server starts without TLS.
SEALOG_SERVER_TLS_PRIVKEY=
SEALOG_SERVER_TLS_FULLCHAIN=


# -------------------------------------------------------------------------
# config/db_constants.js - database names
# -------------------------------------------------------------------------

# Mongo database name used in production/debug mode
SEALOG_DB_NAME=sealogDB

# Mongo database name used in development/demo mode
SEALOG_DB_DEVEL_NAME=sealogDB_devel


# -------------------------------------------------------------------------
# config/secret.js - authentication
# -------------------------------------------------------------------------

# JWT signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(256).toString('base64'));"
SEALOG_SERVER_SECRET=


# -------------------------------------------------------------------------
# config/server_settings.js - filesystem paths + access control
# -------------------------------------------------------------------------

# Root path for uploaded files (images/cruises/lowerings subfolders live under this)
SEALOG_SERVER_FILEPATH_ROOT=/opt/sealog-server/sealog-files

# Server-side reCAPTCHA secret. Leave unset to disable reCAPTCHA bot protection.
SEALOG_SERVER_RECAPTCHA_SECRET=

# Disable self-registration of new users (true/false). Requires an admin to
# enable accounts manually when true.
SEALOG_SERVER_DISABLE_REGISTERING_USERS=false

# Enable per-cruise/per-lowering access control (true/false)
SEALOG_SERVER_USE_ACCESS_CONTROL=false


# -------------------------------------------------------------------------
# config/email_settings.js - outgoing email
# -------------------------------------------------------------------------

# "From" address used for all outgoing emails
SEALOG_SERVER_SENDER_ADDRESS=

# Comma-separated list of additional recipients (BCC) for sent emails
SEALOG_SERVER_NOTIFICATION_EMAIL_ADDRESSES=

# --- Gmail OAuth2 transport ---
# Enabled automatically when all three of the following are set.
# See https://nodemailer.com/smtp/oauth2
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Mailgun transport (alternate provider) ---
# Requires uncommenting the Mailgun block in config/email_settings.js
# MG_APIKEY=
# MG_DOMAIN=

# --- Mailjet transport (alternate provider) ---
# Requires uncommenting the Mailjet block in config/email_settings.js
# MJ_APIKEY_PUBLIC=
# MJ_APIKEY_PRIVATE=
