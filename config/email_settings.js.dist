// The sender address for all emails
const senderAddress = process.env.SEALOG_SERVER_SENDER_ADDRESS || '<SENDER_ADDRESS>';

// Additional receipents for and sent emails.
const notificationEmailAddresses = process.env.SEALOG_SERVER_NOTIFICATION_EMAIL_ADDRESSES
  ? process.env.SEALOG_SERVER_NOTIFICATION_EMAIL_ADDRESSES.split(',').map((address) => address.trim()).filter(Boolean)
  : ['<BCC_ADDRESS>'];

