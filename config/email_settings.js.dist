// The sender address for all emails
const senderAddress = process.env.SEALOG_SERVER_SENDER_ADDRESS || '<SENDER_ADDRESS>';

// Additional receipents for and sent emails.
const notificationEmailAddresses = process.env.SEALOG_SERVER_NOTIFICATION_EMAIL_ADDRESSES
  ? process.env.SEALOG_SERVER_NOTIFICATION_EMAIL_ADDRESSES.split(',').map((address) => address.trim()).filter(Boolean)
  : ['<BCC_ADDRESS>'];

// Needed for email integration
let emailTransporter = null;
const Nodemailer = require('nodemailer');

// ========================================================================= //
// Configure ONE of the following providers for email integration
// ========================================================================= //

// ------------------------------------------------------------------------- //
// Gmail OAuth2 integration
// Enabled automatically when GMAIL_CLIENT_ID, GMAIL_CLIENT_SECRET, and
// GMAIL_REFRESH_TOKEN are all set. https://nodemailer.com/smtp/oauth2
// ------------------------------------------------------------------------- //
const gmailClientId = process.env.GMAIL_CLIENT_ID;
const gmailClientSecret = process.env.GMAIL_CLIENT_SECRET;
const gmailRefreshToken = process.env.GMAIL_REFRESH_TOKEN;

if (gmailClientId && gmailClientSecret && gmailRefreshToken) {
  // Nodemailer obtains and refreshes access tokens as needed.
  emailTransporter = Nodemailer.createTransport({
    service: 'gmail',
    auth: {
      type: 'OAuth2',
      user: senderAddress,
      clientId: gmailClientId,
      clientSecret: gmailClientSecret,
      refreshToken: gmailRefreshToken
    }
  }); // eslint-disable-line no-dupe-keys
}

